:root {
  color-scheme: light;
  --bg: #f4f4f1; --surface: #fcfcfb; --ink: #0b0b0b; --ink2: #52514e; --muted: #6b6b66;
  --line: #e4e3df; --accent: #2a78d6;
  --pass: #0b7a0b; --pass-bg: #e3f4e3; --fail: #b42323; --fail-bg: #fbe5e5;
  --warn: #8a5a00; --warn-bg: #fdf1d6; --na: #6b6b66; --na-bg: #ecebe7;
}
@media (prefers-color-scheme: dark) {
  :root {
    color-scheme: dark;
    --bg: #121211; --surface: #1a1a19; --ink: #ffffff; --ink2: #c3c2b7; --muted: #9b9a92;
    --line: #2f2f2c; --accent: #3987e5;
    --pass: #6fd66f; --pass-bg: #173317; --fail: #ff8a8a; --fail-bg: #3a1717;
    --warn: #f2c25b; --warn-bg: #3a2e12; --na: #9b9a92; --na-bg: #262624;
  }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--ink);
  font: 14px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
main { max-width: 1100px; margin: 0 auto; padding: 24px 16px 48px; }
h1 { font-size: 22px; margin: 0 0 4px; }
h2 { font-size: 17px; margin: 32px 0 8px; }
h3 { font-size: 15px; margin: 0; }
p { margin: 6px 0; }
.muted { color: var(--muted); }
.card { background: var(--surface); border: 1px solid var(--line); border-radius: 8px;
  padding: 16px; margin: 12px 0; }
.kv { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 6px 20px; margin-top: 10px; }
.kv div { display: flex; justify-content: space-between; gap: 8px;
  border-bottom: 1px solid var(--line); padding: 2px 0; }
.kv span:first-child { color: var(--ink2); }
.kv span:last-child { font-variant-numeric: tabular-nums; text-align: right;
  overflow-wrap: anywhere; }
.badge { display: inline-block; border-radius: 4px; padding: 1px 8px; font-size: 12px;
  font-weight: 600; letter-spacing: .02em; }
.badge.ok, .badge.PASS { color: var(--pass); background: var(--pass-bg); }
.badge.failed, .badge.FAIL { color: var(--fail); background: var(--fail-bg); }
.badge.warn { color: var(--warn); background: var(--warn-bg); }
.badge.skipped_no_input, .badge.skipped_by_user, .badge.NA { color: var(--na);
  background: var(--na-bg); }
.scroll { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-size: 13px; }
th, td { text-align: left; padding: 4px 8px; border-bottom: 1px solid var(--line);
  vertical-align: top; }
th { color: var(--ink2); font-weight: 600; white-space: nowrap; }
td.num { text-align: right; font-variant-numeric: tabular-nums; }
.section-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
figure { margin: 12px 0 0; }
figure img { max-width: min(100%, 720px); height: auto; border-radius: 6px; border: 1px solid var(--line);
  background: #fcfcfb; }
figcaption { color: var(--muted); font-size: 12px; }
.figs { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
  gap: 12px; }
.figs figure img { max-width: 100%; }
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 12px; }
pre { background: var(--bg); border-radius: 6px; padding: 10px; overflow-x: auto;
  font-size: 12px; }
details summary { cursor: pointer; color: var(--ink2); }
nav a { color: var(--accent); margin-right: 12px; text-decoration: none; font-size: 13px; }
